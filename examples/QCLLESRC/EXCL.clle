/* ---------------------------------------------------------------- */
/* EXCL - Use the mocks from a CL program                           */
/*                                                                  */
/* Features: IMOQWHEN, IMOQCOUNT, IMOQGETARG and IMOQVERIFY with     */
/*           MONMSG. IMOQCOUNT and IMOQGETARG return values into CL */
/*           variables, so they only work in CL programs.           */
/* Everything happens in this one program; there is no RPG part.    */
/*   CRTBNDCL PGM(IMOQ/EXCL) SRCFILE(IMOQ/QCLLESRC)                 */
/*   CALL IMOQ/EXCL PARM('IMOQ')                                    */
/* ---------------------------------------------------------------- */
             PGM        PARM(&LIB)
             DCL        VAR(&LIB) TYPE(*CHAR) LEN(10)
             DCL        VAR(&NAME) TYPE(*CHAR) LEN(30)
             DCL        VAR(&FOUND) TYPE(*CHAR) LEN(1)
             DCL        VAR(&COUNT) TYPE(*DEC) LEN(10 0)
             DCL        VAR(&ARG) TYPE(*CHAR) LEN(256)
             DCL        VAR(&FAILED) TYPE(*LGL) VALUE('0')

             CHGCURLIB  CURLIB(&LIB)

/* 1. Create the mock */
             IMOQPGM    OBJ(EXCUST) PARMS((*CHAR 5) (*CHAR 30) (*IND))

/* 2. When EXCUST is called for C0042, fill in name and found flag */
             IMOQWHEN   OBJ(EXCUST) ARGS((1 *EQ C0042)) +
                          SETPARM((2 'Grace Hopper') (3 '1'))

             CALL       PGM(EXCUST) PARM('C0042' &NAME &FOUND)
             IF         COND(&NAME *NE 'Grace Hopper' *OR &FOUND *NE +
                          '1') THEN(SNDPGMMSG MSGID(CPF9898) +
                          MSGF(QCPFMSG) MSGDTA('SETPARM values +
                          were not returned') MSGTYPE(*ESCAPE))

/* 3. How many calls, and what was passed? */
             IMOQCOUNT  OBJ(EXCUST) RTNVAL(&COUNT)
             IF         COND(&COUNT *NE 1) THEN(SNDPGMMSG +
                          MSGID(CPF9898) MSGF(QCPFMSG) +
                          MSGDTA('IMOQCOUNT should be 1') +
                          MSGTYPE(*ESCAPE))
             IMOQGETARG OBJ(EXCUST) PARM(1) CALL(*LAST) RTNVAL(&ARG)
             IF         COND(&ARG *NE 'C0042') THEN(SNDPGMMSG +
                          MSGID(CPF9898) MSGF(QCPFMSG) +
                          MSGDTA('IMOQGETARG should return C0042') +
                          MSGTYPE(*ESCAPE))

/* 4. A passing verification returns normally ... */
             IMOQVERIFY OBJ(EXCUST) ARGS((1 *EQ C0042)) TIMES(*ONCE)

/* ... a failing one sends IMQ0200, which you can monitor */
             IMOQVERIFY OBJ(EXCUST) TIMES(*NEVER)
             MONMSG     MSGID(IMQ0200) EXEC(CHGVAR VAR(&FAILED) +
                          VALUE('1'))
             IF         COND(*NOT &FAILED) THEN(SNDPGMMSG +
                          MSGID(CPF9898) MSGF(QCPFMSG) +
                          MSGDTA('TIMES(*NEVER) should have failed') +
                          MSGTYPE(*ESCAPE))

/* 5. Remove the mock */
             IMOQRMV
             SNDPGMMSG  MSGID(CPF9897) MSGF(QCPFMSG) MSGDTA('EXCL +
                          passed') MSGTYPE(*COMP)
             ENDPGM
