/* ---------------------------------------------------------------- */
/* EXVERIFY - Check how many times a dependency was called          */
/*                                                                  */
/* Driver for test program EXVERIFY_T.                              */
/*   CRTBNDCL PGM(IMOQ/EXVERIFY) SRCFILE(IMOQ/QCLLESRC)             */
/*   CALL IMOQ/EXVERIFY PARM('IMOQ')                                */
/* ---------------------------------------------------------------- */
             PGM        PARM(&LIB)
             DCL        VAR(&LIB) TYPE(*CHAR) LEN(10)
             DCL        VAR(&MSG) TYPE(*CHAR) LEN(512)

/* iMoq and the example source are in &LIB                          */
             CHGCURLIB  CURLIB(&LIB)

/* 1. Create the mock                                               */
             IMOQSRVPGM OBJ(EXPRICE)
             IMOQPROC   OBJ(EXPRICE) PROC(EX_PRICE) +
                          RTNTYPE(*PACKED 7 2) PARMS((*CHAR 5 *CONST))
             IMOQPROC   OBJ(EXPRICE) PROC(EX_LOG) +
                          PARMS((*CHAR 50 *CONST))
             IMOQBUILD  OBJ(EXPRICE)

/* 2. Compile the test program                                      */
             CRTRPGMOD  MODULE(QTEMP/EXVERIFY_T) SRCFILE(&LIB/QRPGLESRC)
             CRTPGM     PGM(QTEMP/EXVERIFY_T) MODULE(QTEMP/EXVERIFY_T) +
                          BNDSRVPGM((*LIBL/EXPRICE) (*LIBL/IMOQENG)) +
                          ACTGRP(*NEW)

/* 3. Run it. A failed expect() arrives as escape message CPF9898.  */
             CALL       PGM(QTEMP/EXVERIFY_T)
             MONMSG     MSGID(CPF9898) EXEC(DO)
             RCVMSG     MSGTYPE(*EXCP) MSG(&MSG)
             SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) MSGDTA('EXVERIFY +
                          failed:' *BCAT &MSG) MSGTYPE(*ESCAPE)
             ENDDO

/* 4. Remove the mock                                               */
             IMOQRMV
             SNDPGMMSG  MSGID(CPF9897) MSGF(QCPFMSG) MSGDTA('EXVERIFY +
                          passed') MSGTYPE(*COMP)
             ENDPGM
