**free
// ------------------------------------------------------------------
// EXAMPLE_H - expect(), the tiny assertion used by the examples
//
// A stand-in for a test framework's assertions (such as RPGUnit's
// assert). Copy it in after the example's own declarations: it
// contains a procedure, so it must come after all global definitions.
// ------------------------------------------------------------------

// ------------------------------------------------------------------
// expect(condition : description)
// Stops the example with an escape message when condition is false.
// ------------------------------------------------------------------
dcl-proc expect;
  dcl-pi *n;
    condition ind const;
    description varchar(200) const;
  end-pi;

  dcl-pr sendMessage extpgm('QMHSNDPM');
    msgId char(7) const;
    msgFile char(20) const;
    msgData char(200) const;
    msgDataLen int(10) const;
    msgType char(10) const;
    callStack char(10) const;
    callStackCounter int(10) const;
    msgKey char(4);
    errorCode char(8);
  end-pr;
  dcl-s key char(4);
  dcl-s noErrorCode char(8) inz(*allx'00');

  if not condition;
    // *CTLBDY: send the escape to whoever called the example program
    sendMessage('CPF9898' : 'QCPFMSG   *LIBL' : description
               : %len(description) : '*ESCAPE' : '*CTLBDY' : 1
               : key : noErrorCode);
  endif;
end-proc;
